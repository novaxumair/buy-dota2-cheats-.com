---
import BaseLayout from '../layouts/BaseLayout.astro'
import HeroVideoBg from '../components/HeroVideoBg.astro'
import { HomePage } from '../views/HomePage'
import { SEO } from '../data/site'
import { productCoreJsonLd } from '../lib/seo'
---

<BaseLayout
  seo={SEO.home}
  jsonLdExtra={[productCoreJsonLd()]}
>
  <div class="relative text-white">
    <HeroVideoBg variant="home" />
    <section id="home" class="relative z-10 flex min-h-[100svh] flex-col overflow-x-clip">
      <HomePage client:load bareHero />
    </section>
  </div>
</BaseLayout>
