---
import { CHECKOUT_OUTBOUND } from '../data/links'

const outbound = CHECKOUT_OUTBOUND
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0;url=${outbound}`} />
    <link rel="canonical" href="https://buyislecheats.com/checkout" />
    <title>Redirecting to checkout…</title>
    <script is:inline define:vars={{ outbound }}>
      window.location.replace(outbound)
    </script>
  </head>
  <body
    style="margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#08060f;color:#f3f0ff;font-family:Georgia,serif"
  >
    <h1 style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0">
      Redirecting to checkout
    </h1>
    <p style="font-size:0.95rem;opacity:0.8">Redirecting to checkout…</p>
    <noscript>
      <p>
        <a href={outbound} rel="nofollow noopener noreferrer">Continue to checkout</a>
      </p>
    </noscript>
  </body>
</html>
