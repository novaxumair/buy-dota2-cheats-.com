{
  "name": "buydota2cheats",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 5174",
    "build": "node scripts/generate-seo-assets.mjs && astro build && node scripts/generate-sitemaps.mjs && node scripts/verify-seo.mjs && node scripts/verify-redirects.mjs && node scripts/verify-single-game.mjs",
    "preview": "astro preview --port 5175",
    "build:worker": "npm run build",
    "deploy:worker": "node scripts/cf-worker-deploy.mjs",
    "deploy:worker:full": "npm run build && wrangler deploy -c wrangler.worker.toml",
    "deploy:pages": "node scripts/cf-pages-deploy.mjs",
    "deploy": "npm run build && npm run deploy:worker",
    "check": "astro check",
    "generate:sitemaps": "node scripts/generate-sitemaps.mjs",
    "generate:seo-assets": "node scripts/generate-seo-assets.mjs",
    "generate:content": "node scripts/generate-dota2-content.mjs",
    "prepare:logo": "node scripts/build-logo-assets.mjs",
    "prepare:media": "node scripts/prepare-dota2-media.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "verify:live-sitemap": "node scripts/verify-live-sitemap.mjs",
    "ping:google-sitemap": "node scripts/ping-google-sitemap.mjs",
    "verify:redirects": "node scripts/verify-redirects.mjs",
    "lint": "oxlint",
    "postinstall": "node scripts/patch-wrangler-bin.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource/cinzel": "^5.3.0",
    "astro": "^5.18.2",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.5",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "sharp": "^0.34.4",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "wrangler": "^4.131.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
